@using MyFirstDotNetApp.Dto
@model UserLoginDto

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<form asp-action="UserLogin" method="POST" class="container d-flex justify-content-center align-items-center" style="min-height:100vh">
    <div class="card p-4 shadow" style="width: 100%; max-width: 400px;">
        <h2 class="text-center mb-4">Login</h2>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input type="email" id="email" name="email" asp-for="Email" class="form-control"
                   placeholder="Enter your email" />
            <span asp-validation-for="Email"
                class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <input type="password" id="password" name="password" asp-for="Password" class="form-control"
                   placeholder="Enter your password" />
            <span asp-validation-for="Password"
                class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">
            Login
        </button>

        <div class="text-center mt-3">
            <span>You don't have an account?</span>
            <a asp-controller="Auth" asp-action="Register" class="text-decoration-none">
                Register
            </a>
        </div>
    </div>
</form>