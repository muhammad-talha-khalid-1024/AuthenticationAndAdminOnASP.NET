@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Products";
}

<h3 class="fw-bold">
    @ViewData["Title"]
</h3>

<p class="text-muted text-end">
    <a asp-controller="Products" asp-action="Create" class="btn btn-primary px-4 shadow-sm">

        <i class="fa fa-plus-lg me-2"></i>
        Add Product

    </a>
</p>

<!-- Product Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">

    <!-- Card Header -->
    <div class="card-header bg-white border-0 py-3 px-4">

        <div class="row align-items-center">

            <div class="col-md-6">

                <div class="d-flex align-items-center gap-2">

                    <div class="bg-primary bg-opacity-10
                        text-primary rounded-3 p-2">

                        <i class="fa fa-box-seam fs-5"></i>

                    </div>

                    <div>
                        <h5 class="fw-bold mb-0">
                            Product List
                        </h5>

                        <small class="text-muted">
                            24 products
                        </small>
                    </div>

                </div>

            </div>


            <!-- Search -->
            <div class="col-md-4 ms-auto mt-3 mt-md-0">

                <div class="input-group">

                    <span class="input-group-text bg-light border-end-0">
                        <i class="fa fa-search text-muted"></i>
                    </span>

                    <input type="text" class="form-control bg-light border-start-0" placeholder="Search products..." />

                </div>

            </div>

        </div>

    </div>


    <!-- Table -->
    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="bg-light">

                <tr>

                    <th class="ps-4 text-muted small fw-semibold">
                        #
                    </th>

                    <th class="text-muted small fw-semibold">
                        PRODUCT
                    </th>

                    <th class="text-muted small fw-semibold">
                        DESCRIPTION
                    </th>

                    <th class="text-muted small fw-semibold">
                        PRICE
                    </th>

                    <th class="text-muted small fw-semibold">
                        COLOR
                    </th>

                    <th class="text-muted small fw-semibold text-end pe-4">
                        ACTIONS
                    </th>

                </tr>

            </thead>


            <tbody>

                <!-- Product 1 -->
                <tr>

                    <td class="ps-4 text-muted">
                        1
                    </td>

                    <td>

                        <div class="d-flex align-items-center">

                            <div class="product-icon bg-primary bg-opacity-10
                                text-primary rounded-3 me-3">

                                <i class="fa fa-phone fs-5"></i>

                            </div>

                            <div>

                                <div class="fw-semibold">
                                    iPhone 15 Pro
                                </div>

                                <small class="text-muted">
                                    Electronics
                                </small>

                            </div>

                        </div>

                    </td>

                    <td class="text-muted">
                        Premium smartphone with titanium design.
                    </td>

                    <td>
                        <span class="fw-semibold">
                            $999.00
                        </span>
                    </td>

                    <td>

                        <span class="d-inline-flex align-items-center">

                            <span class="color-dot bg-dark"></span>

                            Black

                        </span>

                    </td>

                    <td class="text-end pe-4">

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Products" asp-action="Edit" asp-route-id="1"
                               class="btn btn-sm btn-light border" title="Edit">

                                <i class="fa fa-pencil text-primary"></i>

                            </a>

                            <button type="button" class="btn btn-sm btn-light border" title="Delete">

                                <i class="fa fa-trash text-danger"></i>

                            </button>

                        </div>

                    </td>

                </tr>


                <!-- Product 2 -->
                <tr>

                    <td class="ps-4 text-muted">
                        2
                    </td>

                    <td>

                        <div class="d-flex align-items-center">

                            <div class="product-icon bg-success bg-opacity-10
                                text-success rounded-3 me-3">

                                <i class="fa fa-laptop fs-5"></i>

                            </div>

                            <div>

                                <div class="fw-semibold">
                                    MacBook Air
                                </div>

                                <small class="text-muted">
                                    Computers
                                </small>

                            </div>

                        </div>

                    </td>

                    <td class="text-muted">
                        Lightweight laptop with powerful performance.
                    </td>

                    <td>
                        <span class="fw-semibold">
                            $1,299.00
                        </span>
                    </td>

                    <td>

                        <span class="d-inline-flex align-items-center">

                            <span class="color-dot bg-secondary"></span>

                            Silver

                        </span>

                    </td>

                    <td class="text-end pe-4">

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Products" asp-action="Edit" asp-route-id="2"
                               class="btn btn-sm btn-light border">

                                <i class="fa fa-pencil text-primary"></i>

                            </a>

                            <button type="button" class="btn btn-sm btn-light border">

                                <i class="fa fa-trash text-danger"></i>

                            </button>

                        </div>

                    </td>

                </tr>


                <!-- Product 3 -->
                <tr>

                    <td class="ps-4 text-muted">
                        3
                    </td>

                    <td>

                        <div class="d-flex align-items-center">

                            <div class="product-icon bg-warning bg-opacity-10
                                text-warning rounded-3 me-3">

                                <i class="fa fa-headphones fs-5"></i>

                            </div>

                            <div>

                                <div class="fw-semibold">
                                    AirPods Pro
                                </div>

                                <small class="text-muted">
                                    Accessories
                                </small>

                            </div>

                        </div>

                    </td>

                    <td class="text-muted">
                        Wireless earbuds with active noise cancellation.
                    </td>

                    <td>
                        <span class="fw-semibold">
                            $249.00
                        </span>
                    </td>

                    <td>

                        <span class="d-inline-flex align-items-center">

                            <span class="color-dot bg-white border"></span>

                            White

                        </span>

                    </td>

                    <td class="text-end pe-4">

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Products" asp-action="Edit" asp-route-id="3"
                               class="btn btn-sm btn-light border">

                                <i class="fa fa-pencil text-primary"></i>

                            </a>

                            <button type="button" class="btn btn-sm btn-light border">

                                <i class="fa fa-trash text-danger"></i>

                            </button>

                        </div>

                    </td>

                </tr>


                <!-- Product 4 -->
                <tr>

                    <td class="ps-4 text-muted">
                        4
                    </td>

                    <td>

                        <div class="d-flex align-items-center">

                            <div class="product-icon bg-danger bg-opacity-10
                                text-danger rounded-3 me-3">

                                <i class="fa fa-watch fs-5"></i>

                            </div>

                            <div>

                                <div class="fw-semibold">
                                    Apple Watch
                                </div>

                                <small class="text-muted">
                                    Wearables
                                </small>

                            </div>

                        </div>

                    </td>

                    <td class="text-muted">
                        Smart watch with health and fitness tracking.
                    </td>

                    <td>
                        <span class="fw-semibold">
                            $399.00
                        </span>
                    </td>

                    <td>

                        <span class="d-inline-flex align-items-center">

                            <span class="color-dot bg-danger"></span>

                            Red

                        </span>

                    </td>

                    <td class="text-end pe-4">

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Products" asp-action="Edit" asp-route-id="4"
                               class="btn btn-sm btn-light border">

                                <i class="fa fa-pencil text-primary"></i>

                            </a>

                            <button type="button" class="btn btn-sm btn-light border">

                                <i class="fa fa-trash text-danger"></i>

                            </button>

                        </div>

                    </td>

                </tr>

            </tbody>

        </table>

    </div>


    <!-- Card Footer -->
    <div class="card-footer bg-white border-0 px-4 py-3">

        <div class="d-flex justify-content-between align-items-center">

            <small class="text-muted">
                Showing <strong>1</strong> to <strong>4</strong>
                of <strong>24</strong> products
            </small>

            <nav>
                <ul class="pagination pagination-sm mb-0">

                    <li class="page-item disabled">
                        <a class="page-link">
                            Previous
                        </a>
                    </li>

                    <li class="page-item active">
                        <a class="page-link">
                            1
                        </a>
                    </li>

                    <li class="page-item">
                        <a class="page-link">
                            2
                        </a>
                    </li>

                    <li class="page-item">
                        <a class="page-link">
                            3
                        </a>
                    </li>

                    <li class="page-item">
                        <a class="page-link">
                            Next
                        </a>
                    </li>

                </ul>
            </nav>

        </div>

    </div>

</div>